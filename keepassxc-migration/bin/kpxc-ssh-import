#!/usr/bin/env python3
"""Import SSH private keys into a KeePassXC database as agent-loadable entries.

Each key becomes one entry with three attachments: the private key, the public
key, and a KeeAgent.settings block that makes KeePassXC load the key into the
running ssh-agent whenever the database is unlocked, and drop it when locked.

The work goes through keepassxc-cli, which is the only supported way to write a
KDBX from outside the GUI. The database password is asked once and passed to
each call over stdin; it is never printed, logged or stored.

Close the database in KeePassXC first: with it open, KeePassXC overwrites the
file with its in-memory copy and this import silently disappears.
"""

import argparse
import getpass
import os
import shutil
import subprocess
import sys
import tempfile

KEEAGENT = """<?xml version="1.0" encoding="UTF-8"?>
<EntrySettings>
  <AllowUseOfSshKey>true</AllowUseOfSshKey>
  <AddAtDatabaseOpen>true</AddAtDatabaseOpen>
  <RemoveAtDatabaseClose>true</RemoveAtDatabaseClose>
  <UseConfirmConstraintWhenAdding>false</UseConfirmConstraintWhenAdding>
  <UseLifetimeConstraintWhenAdding>false</UseLifetimeConstraintWhenAdding>
  <LifetimeConstraintDuration>600</LifetimeConstraintDuration>
  <Location>
    <SelectedType>attachment</SelectedType>
    <AttachmentName>%s</AttachmentName>
    <SaveAttachmentToTempFile>false</SaveAttachmentToTempFile>
    <FileName></FileName>
  </Location>
</EntrySettings>
"""

HOME = os.path.expanduser('~')
CONFIG = os.environ.get('XDG_CONFIG_HOME') or os.path.join(HOME, '.config')


def guess_database():
    """Last database KeePassXC opened, if its config names one."""
    path = os.path.join(CONFIG, 'keepassxc/keepassxc.ini')
    if not os.path.isfile(path):
        return None
    try:
        with open(path, errors='replace') as handle:
            for line in handle:
                if line.split('=')[0].strip() in ('LastDatabases',
                                                  'LastActiveDatabase'):
                    candidate = line.split('=', 1)[1].strip().split(',')[0]
                    candidate = os.path.expanduser(candidate)
                    if candidate.endswith('.kdbx') and os.path.isfile(candidate):
                        return candidate
    except OSError:
        return None
    return None


def agent_restart_hint():
    """How to restart whatever currently provides SSH_AUTH_SOCK."""
    sock = os.environ.get('SSH_AUTH_SOCK', '')
    if '/gcr/' in sock:
        return 'systemctl --user restart gcr-ssh-agent.service'
    if 'keyring' in sock:
        return 'systemctl --user restart gnome-keyring-daemon.service'
    if sock:
        return 'restart whatever provides SSH_AUTH_SOCK (%s)' % sock
    return 'start an ssh-agent and export SSH_AUTH_SOCK'


def is_private_key(path):
    try:
        with open(path, 'rb') as handle:
            return b'PRIVATE KEY' in handle.read(80)
    except OSError:
        return False


def find_keys(ssh_dir):
    keys = []
    for name in sorted(os.listdir(ssh_dir)):
        path = os.path.join(ssh_dir, name)
        if name.endswith('.pub') or not os.path.isfile(path):
            continue
        if is_private_key(path):
            keys.append(name)
    return keys


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--db', default=None, help='path to the .kdbx file')
    parser.add_argument('--group', default='ssh-keys',
                        help='group to create the entries in (default: ssh-keys)')
    parser.add_argument('--ssh-dir', default=os.path.join(HOME, '.ssh'))
    parser.add_argument('--backup-dir', default=None,
                        help='directory to copy the key files into first')
    parser.add_argument('--dry-run', action='store_true')
    args = parser.parse_args()

    if not shutil.which('keepassxc-cli'):
        sys.exit('keepassxc-cli is not installed')

    database = args.db or guess_database()
    if not database:
        sys.exit('no database given and none found in the KeePassXC config; '
                 'pass --db')
    if not os.path.isfile(database):
        sys.exit('no such database: %s' % database)

    if not os.path.isdir(args.ssh_dir):
        sys.exit('no such directory: %s' % args.ssh_dir)
    keys = find_keys(args.ssh_dir)
    if not keys:
        sys.exit('no private keys found in %s' % args.ssh_dir)

    missing_pub = [k for k in keys
                   if not os.path.isfile(os.path.join(args.ssh_dir, k + '.pub'))]
    for name in missing_pub:
        source = os.path.join(args.ssh_dir, name)
        result = subprocess.run(['ssh-keygen', '-y', '-f', source],
                                capture_output=True)
        if result.returncode == 0 and result.stdout.strip():
            if not args.dry_run:
                with open(source + '.pub', 'wb') as handle:
                    handle.write(result.stdout)
                os.chmod(source + '.pub', 0o644)
            print('derived public key for %s' % name)
        else:
            print('cannot derive a public key for %s '
                  '(passphrase-protected?), skipping' % name)
            keys.remove(name)

    print('keys to import: %d' % len(keys))
    for name in keys:
        print('  ', name)
    if args.dry_run:
        return 0

    if args.backup_dir:
        os.makedirs(args.backup_dir, exist_ok=True)
        for name in keys:
            shutil.copy2(os.path.join(args.ssh_dir, name),
                         os.path.join(args.backup_dir, name))
        os.chmod(args.backup_dir, 0o700)
        print('key files copied to %s' % args.backup_dir)

    password = getpass.getpass('database password: ')

    def cli(*argv):
        command = ['keepassxc-cli', argv[0], '-q'] + list(argv[1:])
        result = subprocess.run(command, input=password + '\n', text=True,
                                capture_output=True)
        return result.returncode, (result.stdout or '') + (result.stderr or '')

    code, out = cli('ls', database, args.group)
    if code != 0:
        if 'Cannot find group' in out:
            print('group %s does not exist, creating it' % args.group)
            code, out = cli('mkdir', database, args.group)
            if code != 0:
                sys.exit('cannot create the group: %s' % out.strip()[:200])
            out = ''
        else:
            sys.exit('cannot open the database: %s' % out.strip()[:200])
    existing = {line.strip().rstrip('/') for line in out.splitlines()
                if line.strip()}

    added = skipped = 0
    for name in keys:
        if name in existing:
            skipped += 1
            continue
        path = '%s/%s' % (args.group, name)
        code, out = cli('add', database, path)
        if code != 0:
            print('  ERROR creating %s: %s' % (name, out.strip()[:160]))
            continue
        ok = True
        attachments = [(name, os.path.join(args.ssh_dir, name)),
                       (name + '.pub', os.path.join(args.ssh_dir, name + '.pub'))]
        with tempfile.NamedTemporaryFile('w', suffix='.xml',
                                         delete=False) as handle:
            handle.write(KEEAGENT % name)
            settings = handle.name
        attachments.append(('KeeAgent.settings', settings))
        for attachment_name, source in attachments:
            code, out = cli('attachment-import', database, path,
                            attachment_name, source)
            if code != 0:
                print('  ERROR attaching %s: %s'
                      % (attachment_name, out.strip()[:160]))
                ok = False
        os.unlink(settings)
        print('  %s: %s' % (name, 'imported' if ok else 'imported with errors'))
        added += 1

    print('\nadded: %d, skipped: %d' % (added, skipped))
    code, out = cli('ls', database, args.group)
    print('group %s now holds:' % args.group)
    for line in out.splitlines():
        if line.strip():
            print('  ', line.strip())

    print("""
Next:
  1. open the database in KeePassXC
  2. Tools -> Settings -> SSH Agent -> enable the integration
  3. lock and unlock the database, then check: ssh-add -l
  4. prove a real connection works before deleting anything
The key files are still in place; delete them yourself once the agent serves
them. If stale entries make signing fail with "agent refused operation",
restart the agent:
  %s""" % agent_restart_hint())
    return 0


if __name__ == '__main__':
    sys.exit(main())
