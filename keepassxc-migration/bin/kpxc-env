#!/usr/bin/env python3
"""Keep shell environment secrets in KeePassXC instead of a dotfile.

Variables live as entries in the database and reach a shell only while it is
unlocked. Nothing is written to disk: `export` prints shell code, the shell
evaluates it, and a locked database simply yields an empty environment.

  kpxc-env list                      names and whether each one is actually
                                     released, never values
  kpxc-env export                    shell code for eval: silent when locked,
                                     loud on stderr when something is broken
  kpxc-env import --from ~/.bashrc   move export lines into the database
  kpxc-env hot NAME...               keep a variable out of the ambient
                                     environment; only kpxc-run injects it
  kpxc-env shim terraform doctl      put wrappers in ~/.local/bin so any caller
                                     gets the hot variables without knowing
  kpxc-env install                   symlink these tools into ~/.local/bin,
                                     which the loader line below needs, and
                                     check that the system python3 can read
                                     the database

Add this to ~/.bashrc, and to ~/.profile as BASH_ENV so that non-interactive
shells are covered too:

  command -v kpxc-env >/dev/null && eval "$(kpxc-env export)"

KeePassXC must hand entries over without a dialog: untick "Confirm when
passwords are retrieved by clients" under Settings > Secret Service
Integration. Every shell start is a new client, and nobody is there to click
Allow - with the option on, the loader gets nothing and the shell stays empty.
"""

import argparse
import base64
import getpass
import os
import re
import shlex
import shutil
import subprocess
import sys
from xml.etree import ElementTree

PROG = 'kpxc-env'
ATTR = 'kpxc-env'
HOT = 'kpxc-env-hot'
PROFILE = 'kpxc-env-profile'
SECRETISH = re.compile(
    r'(TOKEN|SECRET|PASSWORD|PASSWD|_KEY|APIKEY|API_KEY|CLIENT_ID|'
    r'CREDENTIAL|AUTHORIZATION|_PAT|ACCESS_KEY)', re.I)
EXPORT_LINE = re.compile(r'^\s*export\s+([A-Za-z_][A-Za-z0-9_]*)=(.*)$')
HOME = os.path.expanduser('~')
LOCAL_BIN = os.path.join(HOME, '.local/bin')
# Why collection() came back empty. Only a broken install is worth a line on
# stderr at every shell start; a locked database is normal and stays silent.
NO_MODULE, UNREACHABLE, LOCKED = 'module', 'unreachable', 'locked'
CONFIRM_HINT = ('KeePassXC asks every client for a confirmation dialog, and a '
                'shell start cannot answer one. Untick "Confirm when passwords '
                'are retrieved by clients" in KeePassXC: Settings > Secret '
                'Service Integration.')

DEFAULT_DB = os.path.join(os.path.expanduser('~'), 'Documents',
                          '%s.kdbx' % getpass.getuser())
VARIABLE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
# KeePassXC placeholders this script resolves itself, exactly as `keepassxc-cli
# show` would. Anything else in braces goes to `show` for that one entry.
PLACEHOLDER = re.compile(r'\{[^}]+\}')
REFERENCE = re.compile(r'^\{REF:([TUPANI])@([TUPANI]):([^}]+)\}$')
FIELD = {'T': 'Title', 'U': 'UserName', 'P': 'Password', 'A': 'URL',
         'N': 'Notes'}
STANDARD = {'{TITLE}': 'Title', '{USERNAME}': 'UserName',
            '{PASSWORD}': 'Password', '{URL}': 'URL', '{NOTES}': 'Notes'}


def default_db():
    """The .kdbx to read straight from, or None to use the Secret Service.

    $KEEPPASSXC_DB names it; otherwise ~/Documents/<user>.kdbx when it exists.
    """
    return (os.environ.get('KEEPPASSXC_DB')
            or (DEFAULT_DB if os.path.isfile(DEFAULT_DB) else None))


def cached_password(db):
    runtime = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    path = os.path.join(runtime, 'kpxc-auth')
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    if len(lines) >= 2 and lines[0] == os.path.realpath(db):
        return lines[1]
    return None


def read_password(db=None):
    """Cached session password when present, else stdin/TTY prompt."""
    if db is not None:
        cached = cached_password(db)
        if cached is not None:
            return cached
    if sys.stdin.isatty():
        return getpass.getpass('KeePassXC database password: ')
    line = sys.stdin.readline()
    return line.rstrip('\n')


def keepassxc_cli(password, *cli_args):
    """(returncode, stdout bytes, stderr text). Every call decrypts the whole
    database again, and the key derivation takes seconds by design."""
    proc = subprocess.run(['keepassxc-cli', *cli_args],
                          input=(password + '\n').encode(),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return (proc.returncode, proc.stdout,
            proc.stderr.decode(errors='replace').strip())


class Unresolved(Exception):
    """A placeholder left for `keepassxc-cli show` to resolve."""


def resolve(value, fields, tree, depth=0):
    """value with its placeholders resolved the way `keepassxc-cli show` does.

    Raises Unresolved for anything not covered here: an unknown or
    lower-case placeholder, a missing reference target, a loop."""
    if not PLACEHOLDER.search(value):
        return value
    if depth > 8:
        raise Unresolved(value)

    def one(match):
        token = match.group(0)
        if token in STANDARD:
            return resolve(fields.get(STANDARD[token], ''), fields, tree,
                           depth + 1)
        if token.startswith('{S:') and token[3:-1] in fields:
            return resolve(fields[token[3:-1]], fields, tree, depth + 1)
        reference = REFERENCE.match(token)
        if not reference:
            raise Unresolved(token)
        wanted, search_in, term = reference.groups()
        for _path, uuid, other in tree:
            if search_in == 'I':
                if len(term) != 32 or uuid != term.lower():
                    continue
            elif other.get(FIELD[search_in], '') != term:
                continue
            if wanted == 'I':
                return uuid
            return resolve(other.get(FIELD[wanted], ''), other, tree,
                           depth + 1)
        raise Unresolved(token)

    return PLACEHOLDER.sub(one, value)


def read_tree(db, password):
    """[(path, uuid hex, {field: raw value})] for every entry, in the order
    `keepassxc-cli ls -R` lists them, from one decryption of the database.

    `keepassxc-cli export` hands the whole tree over as XML on a pipe, so
    nothing reaches the disk. path is None for an entry that keepassxc-cli
    cannot address: an empty title, or a '/' inside a title or group name.
    """
    code, out, err = keepassxc_cli(password, 'export', '-q', '-f', 'xml', db)
    if code != 0:
        sys.exit('%s: cannot read %s: %s' % (PROG, db, err))
    try:
        root = ElementTree.fromstring(out).find('Root/Group')
    except ElementTree.ParseError as error:
        sys.exit('%s: unreadable export of %s: %s' % (PROG, db, error))
    if root is None:
        sys.exit('%s: no entries in the export of %s' % (PROG, db))
    tree = []

    def walk(group, prefix):
        for child in group:
            if child.tag == 'Entry':
                fields = {string.findtext('Key', ''):
                          string.findtext('Value', '')
                          for string in child.findall('String')}
                title = fields.get('Title', '')
                addressable = (prefix is not None and title.strip()
                               and '/' not in title)
                uuid = base64.b64decode(child.findtext('UUID', '')).hex()
                tree.append((prefix + title if addressable else None,
                             uuid, fields))
            elif child.tag == 'Group':
                name = child.findtext('Name', '')
                walk(child, None if prefix is None or '/' in name
                     else prefix + name + '/')

    walk(root, '')
    return tree


def shown(db, password, path, keys):
    """{key: value} via `keepassxc-cli show` for one entry: one more
    decryption, spent only on a placeholder resolve() does not cover."""
    arguments = []
    for key in keys:
        arguments += ['-a', key]
    code, out, _err = keepassxc_cli(password, 'show', '-q', '-s', *arguments,
                                    db, path)
    if code != 0:
        return None
    text = out.decode(errors='replace')
    if keys == ['Password']:
        return {'Password': text[:-1] if text.endswith('\n') else text}
    return dict(zip(keys, text.split('\n')))


def db_entries(db, password, needs_value=lambda name, hot, attrs: True):
    """[(name, value, hot, attrs)] read straight from a .kdbx file.

    Uses keepassxc-cli only: no GUI and no D-Bus Secret Service involved, and
    the database is decrypted once however many entries it holds.
    A variable is an entry whose kpxc-env attribute names it; without the
    attribute the entry title is used when it looks like a shell variable.
    attrs carries the kpxc-env attributes; value is None where needs_value
    said the caller has no use for it.
    """
    tree = read_tree(db, password)
    # keepassxc-cli addresses entries by path, and a path held by two entries
    # always means the first of them.
    first = {}
    for path, _uuid, fields in tree:
        if path is not None:
            first.setdefault(path, fields)
    rows = []
    for path, _uuid, _fields in tree:
        if path is None:
            continue
        fields = first[path]
        keys = [key for key in (ATTR, HOT, PROFILE) if key in fields]
        try:
            attrs = {key: resolve(fields[key], fields, tree) for key in keys}
        except Unresolved:
            attrs = shown(db, password, path, keys)
            if attrs is None:
                continue
        attrs = {key: value.strip() for key, value in attrs.items()}
        name = attrs.get(ATTR) or fields.get('Title', '').strip()
        if not VARIABLE.match(name):
            continue
        hot = bool(attrs.get(HOT))
        value = None
        if needs_value(name, hot, attrs):
            try:
                value = resolve(fields.get('Password', ''), fields, tree)
            except Unresolved:
                value = (shown(db, password, path, ['Password'])
                         or {}).get('Password')
                if value is None:
                    continue
        rows.append((name, value, hot, attrs))
    return rows


def module_install_command():
    """The distro's own package for secretstorage, for the system python3.

    The loader runs under `#!/usr/bin/env python3`, which in a login shell is
    the system interpreter, so a copy inside a venv does not help it."""
    ids = set()
    try:
        with open('/etc/os-release') as handle:
            for line in handle:
                key, _sep, value = line.strip().partition('=')
                if key in ('ID', 'ID_LIKE'):
                    ids.update(value.strip('"').split())
    except OSError:
        pass
    if ids & {'debian', 'ubuntu'}:
        return 'sudo apt install python3-secretstorage'
    if ids & {'fedora', 'rhel', 'centos'}:
        return 'sudo dnf install python3-secretstorage'
    if ids & {'arch', 'manjaro'}:
        return 'sudo pacman -S python-secretstorage'
    if ids & {'suse', 'opensuse'}:
        return 'sudo zypper install python3-secretstorage'
    return 'pip install --user secretstorage  (outside any venv)'


def collection():
    """(collection, None) when the database is unlocked, else (None, (why, text))."""
    try:
        import secretstorage
    except ImportError:
        return None, (NO_MODULE, 'the secretstorage module is not installed for '
                                 '%s - fix: %s' % (sys.executable,
                                                   module_install_command()))
    try:
        connection = secretstorage.dbus_init()
        for item in secretstorage.get_all_collections(connection):
            if item.collection_path.endswith('/session'):
                continue
            if not item.is_locked():
                return item, None
    except Exception as error:                         # noqa: BLE001
        return None, (UNREACHABLE, 'cannot reach the secret service (%s)'
                                   % error.__class__.__name__)
    return None, (LOCKED, 'the database is locked')


def withheld(item):
    """True when KeePassXC holds this entry back from us until a dialog is
    answered: the collection is open, yet the item reports itself locked."""
    try:
        return item.is_locked()
    except Exception:                                  # noqa: BLE001
        return False


def entries(coll):
    """[(name, item, hot)] for every variable stored in the database."""
    found = []
    for item in coll.get_all_items():
        try:
            attrs = item.get_attributes()
        except Exception:                              # noqa: BLE001
            continue
        name = attrs.get(ATTR)
        if name:
            found.append((name, item, attrs.get(HOT) == '1'))
    return sorted(found, key=lambda row: row[0])


def cmd_list(args):
    db = args.db or default_db()
    if db:
        if not os.path.isfile(db):
            print('kpxc-env: database not found: %s' % db, file=sys.stderr)
            return 1
        rows = db_entries(db, read_password(db),
                          lambda _name, _hot, _attrs: False)
        if not rows:
            print('no variables stored yet')
            return 0
        for name, _value, hot, _attrs in rows:
            state = 'hot (kpxc-run only)' if hot else 'exported'
            print('%-32s %s' % (name, state))
        return 0
    coll, problem = collection()
    if coll is None:
        print(problem[1], file=sys.stderr)
        return 1
    rows = entries(coll)
    if not rows:
        print('no variables stored yet')
        return 0
    held = 0
    for name, item, hot in rows:
        state = 'hot (kpxc-run only)' if hot else 'exported'
        if withheld(item):
            held += 1
            state += ', withheld'
        print('%-32s %s' % (name, state))
    if held:
        print('\n%d of %d withheld: %s' % (held, len(rows), CONFIRM_HINT))
    return 0


def cmd_export(args):
    db = args.db or default_db()
    if db:
        if not os.path.isfile(db):
            print('kpxc-env: database not found: %s' % db, file=sys.stderr)
            return 0
        for name, value, hot, _attrs in db_entries(
                db, read_password(db), lambda _name, hot, _attrs: not hot):
            if hot:
                continue
            print('export %s=%s' % (name, shlex.quote(value)))
        return 0
    coll, problem = collection()
    if coll is None:
        # A locked database must not break shells. A missing module is not a
        # locked database: it means every shell will be empty until someone
        # notices, so say so - stderr is not part of what eval picks up.
        if problem[0] == NO_MODULE:
            print('kpxc-env: %s' % problem[1], file=sys.stderr)
        return 0
    from secretstorage.exceptions import LockedException
    held = []
    for name, item, hot in entries(coll):
        if hot:
            continue
        try:
            value = item.get_secret().decode('utf-8', 'replace')
        except LockedException:
            held.append(name)
            continue
        except Exception:                              # noqa: BLE001
            continue
        print('export %s=%s' % (name, shlex.quote(value)))
    if held:
        print('kpxc-env: %d variable(s) withheld, see `kpxc-env list`. %s'
              % (len(held), CONFIRM_HINT), file=sys.stderr)
    return 0


def parse_exports(path):
    """[(name, value, line_number)] for plain export lines in a shell file."""
    found = []
    with open(path, errors='replace') as handle:
        for number, line in enumerate(handle, 1):
            match = EXPORT_LINE.match(line)
            if not match:
                continue
            name, raw = match.group(1), match.group(2).strip()
            # Only unquoted and double-quoted values can expand. Inside single
            # quotes a $ or a backtick is an ordinary character, and treating
            # such a line as computed would silently leave a password behind.
            if raw.startswith("'"):
                computed = False
            elif raw.startswith('"'):
                computed = bool(re.search(r'(?<!\\)[$`]', raw))
            else:
                computed = bool(re.search(r'[$`]', raw))
            if computed:
                continue
            try:
                parts = shlex.split(raw, comments=True)
            except ValueError:
                continue
            if len(parts) != 1:
                continue
            found.append((name, parts[0], number))
    return found


def cmd_import(args):
    path = os.path.expanduser(args.source)
    if not os.path.isfile(path):
        return exit_with('no such file: %s' % path)
    candidates = parse_exports(path)
    if not candidates:
        return exit_with('no plain export lines found in %s' % path)

    chosen = [(n, v, ln) for n, v, ln in candidates
              if (n in args.var) or (not args.var and SECRETISH.search(n))]
    skipped = [n for n, _v, _ln in candidates
               if n not in [c[0] for c in chosen]]

    print('to move into KeePassXC:')
    for name, _value, number in chosen:
        print('  %-32s %s:%d' % (name, os.path.basename(path), number))
    if skipped:
        unique = sorted(set(skipped))
        print('left alone (not secret-looking):')
        print('  ' + ', '.join(unique))
    if not chosen:
        return exit_with('nothing selected; name variables with --var')
    if not args.apply:
        print('\nnothing was changed. Re-run with --apply to store these and '
              'remove\nthe lines from the file (a .bak copy is kept).')
        return 0

    coll, problem = collection()
    if coll is None:
        return exit_with('unlock the database first - it must be open to write '
                         '(%s)' % problem[1])

    hot = set(args.hot)
    stored = []
    for name, value, _number in chosen:
        attrs = {ATTR: name, 'xdg:schema': 'org.freedesktop.Secret.Generic'}
        if name in hot:
            attrs[HOT] = '1'
        stored.append(coll.create_item(name, attrs, value.encode(), replace=True))
    print('stored in the database: %d' % len(chosen))
    if any(withheld(item) for item in stored):
        print('\nWARNING: stored, but KeePassXC will not hand them to the loader.\n'
              '%s' % CONFIRM_HINT)

    backup = path + '.kpxc-bak'
    shutil.copy2(path, backup)
    drop = {number for _n, _v, number in chosen}
    with open(path, errors='replace') as handle:
        lines = handle.readlines()
    # The loader goes where the first removed line was, not at the end: a later
    # line may compute something from a variable that has just been moved, and
    # appending would leave it empty.
    first = min(drop)
    loader = ['# secrets now live in KeePassXC, loaded while unlocked\n',
              'command -v kpxc-env >/dev/null && eval "$(kpxc-env export)"\n']
    already = any('kpxc-env export' in line for line in lines)
    kept = []
    for number, line in enumerate(lines, 1):
        if number == first and not already:
            kept.extend(loader)
        if number not in drop:
            kept.append(line)
    with open(path, 'w') as handle:
        handle.writelines(kept)
    print('%s rewritten, previous copy at %s' % (path, backup))
    if shutil.which('kpxc-env') is None:
        print('\nWARNING: kpxc-env is not on PATH, so the line just written to\n'
              '%s cannot run and the variables would be missing from every\n'
              'shell. Fix it now:  %s install'
              % (os.path.basename(path), os.path.abspath(__file__)))
    else:
        print('open a new shell to pick up the change')
    return 0


def cmd_install(args):
    """Symlink these tools into ~/.local/bin so ordinary shells can find them."""
    os.makedirs(LOCAL_BIN, exist_ok=True)
    here = os.path.dirname(os.path.abspath(__file__))
    for name in sorted(os.listdir(here)):
        source = os.path.join(here, name)
        if not (name.startswith('kpxc-') and os.path.isfile(source)
                and os.access(source, os.X_OK)):
            continue
        target = os.path.join(LOCAL_BIN, name)
        if os.path.islink(target) or os.path.exists(target):
            os.remove(target)
        os.symlink(source, target)
        print('%s -> %s' % (target, source))
    if LOCAL_BIN not in os.environ.get('PATH', '').split(os.pathsep):
        print('\nNote: %s is not in PATH yet - add it in ~/.profile' % LOCAL_BIN)
    # The loader will run under the system python3, whatever this one is.
    system = '/usr/bin/python3'
    if os.path.isfile(system):
        probe = subprocess.run([system, '-c', 'import secretstorage'],
                               capture_output=True)
        if probe.returncode != 0:
            print('\nWARNING: %s has no secretstorage module, so the loader line\n'
                  'would export nothing. Install it for the system interpreter:\n'
                  '  %s' % (system, module_install_command()))
            return 1
    return 0


def cmd_hot(args):
    coll, problem = collection()
    if coll is None:
        return exit_with('unlock the database first (%s)' % problem[1])
    known = {name: item for name, item, _hot in entries(coll)}
    for name in args.name:
        item = known.get(name)
        if item is None:
            print('unknown variable: %s' % name, file=sys.stderr)
            continue
        attrs = dict(item.get_attributes())
        if args.unset:
            attrs.pop(HOT, None)
        else:
            attrs[HOT] = '1'
        item.set_attributes(attrs)
        print('%s: %s' % (name, 'exported again' if args.unset
                          else 'hot, only kpxc-run injects it now'))
    return 0


SHIM = """#!/bin/sh
# Written by kpxc-env: injects secrets from KeePassXC, then runs the real
# %(name)s. Delete this file to go back to the plain binary.
exec kpxc-run --profile %(name)s -- %(real)s "$@"
"""


def cmd_shim(args):
    os.makedirs(LOCAL_BIN, exist_ok=True)
    for name in args.name:
        real = None
        for candidate in os.environ.get('PATH', '').split(os.pathsep):
            if os.path.realpath(candidate) == os.path.realpath(LOCAL_BIN):
                continue
            path = os.path.join(candidate, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                real = path
                break
        if real is None:
            print('%s: not found in PATH outside %s, skipped'
                  % (name, LOCAL_BIN), file=sys.stderr)
            continue
        target = os.path.join(LOCAL_BIN, name)
        with open(target, 'w') as handle:
            handle.write(SHIM % {'name': name, 'real': shlex.quote(real)})
        os.chmod(target, 0o755)
        print('%s -> %s' % (target, real))
    print('\nMake sure %s comes before the real binaries in PATH.' % LOCAL_BIN)
    return 0


def exit_with(message):
    print(message, file=sys.stderr)
    return 1


def main():
    parser = argparse.ArgumentParser(
        prog='kpxc-env', description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = parser.add_subparsers(dest='command')

    listp = sub.add_parser('list', help='names of stored variables')
    listp.add_argument('--db', default=None,
                       help='read straight from this .kdbx via keepassxc-cli '
                            '(defaults to $KEEPPASSXC_DB, else %s when it '
                            'exists, else the Secret Service)' % DEFAULT_DB)
    sub.add_parser('install', help='symlink the tools into ~/.local/bin')
    exportp = sub.add_parser('export', help='shell code for eval')
    exportp.add_argument('--db', default=None,
                         help='read straight from this .kdbx via '
                              'keepassxc-cli (defaults to $KEEPPASSXC_DB, else '
                              '%s when it exists, else the Secret Service)'
                              % DEFAULT_DB)

    imp = sub.add_parser('import', help='move export lines into the database')
    imp.add_argument('--from', dest='source', default='~/.bashrc')
    imp.add_argument('--var', action='append', default=[],
                     help='variable to move, repeatable; default is every '
                          'secret-looking name')
    imp.add_argument('--hot', action='append', default=[],
                     help='store this one as hot: never exported, only '
                          'injected by kpxc-run')
    imp.add_argument('--apply', action='store_true',
                     help='actually store and rewrite the file')

    hot = sub.add_parser('hot', help='mark variables as kpxc-run only')
    hot.add_argument('name', nargs='+')
    hot.add_argument('--unset', action='store_true')

    shim = sub.add_parser('shim', help='wrappers so any caller gets hot vars')
    shim.add_argument('name', nargs='+')

    args = parser.parse_args()
    handlers = {'list': cmd_list, 'export': cmd_export, 'import': cmd_import,
                'hot': cmd_hot, 'shim': cmd_shim, 'install': cmd_install}
    if args.command not in handlers:
        parser.print_help()
        return 2
    return handlers[args.command](args)


if __name__ == '__main__':
    sys.exit(main())
