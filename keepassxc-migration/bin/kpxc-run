#!/usr/bin/env python3
"""Run a command with secrets from KeePassXC in its environment, and nowhere else.

The variables never enter the ambient environment: they are read from the
unlocked database, placed in the child process's environment, and gone when it
exits. This is what the shims written by `kpxc-env shim` call.

With --db, $KEEPPASSXC_DB or an existing ~/Documents/<user>.kdbx they are read
from that file through keepassxc-cli instead, with the password from
$XDG_RUNTIME_DIR/kpxc-auth, else a prompt or one line of stdin.
KEEPPASSXC_DB set to an empty string means the Secret Service.

  kpxc-run --profile terraform -- terraform apply
  kpxc-run --var GITHUB_TOKEN -- gh pr list
  kpxc-run --all -- env            # every stored variable, hot ones included

A profile is just a name listed in an entry's kpxc-env-profile attribute, so a
variable can serve several commands:

  kpxc-env list                    # see what is stored
"""

import argparse
import base64
import getpass
import os
import re
import shutil
import subprocess
import sys
from xml.etree import ElementTree

PROG = 'kpxc-run'
ATTR = 'kpxc-env'
HOT = 'kpxc-env-hot'
PROFILE = 'kpxc-env-profile'
CONFIRM_HINT = ('KeePassXC asks every client for a confirmation dialog and '
                'this one was never answered. Untick "Confirm when passwords '
                'are retrieved by clients" in KeePassXC: Settings > Secret '
                'Service Integration.')

DEFAULT_DB = os.path.join(os.path.expanduser('~'), 'Documents',
                          '%s.kdbx' % getpass.getuser())
VARIABLE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
# KeePassXC 2.7 placeholders, resolved here the way `keepassxc-cli show`
# resolves them (Entry::resolveMultiplePlaceholdersRecursive). Those that
# depend on the clock, the URL parser, TOTP or the file location go to `show`.
PLACEHOLDER = re.compile(r'\{[^}]+\}')
REFERENCE = re.compile(r'\{REF:([TUPANI])@([TUPANIO]):([^}]+)\}', re.I | re.A)
FIELD = {'T': 'Title', 'U': 'UserName', 'P': 'Password', 'A': 'URL',
         'N': 'Notes'}
STANDARD = {'{TITLE}': 'Title', '{USERNAME}': 'UserName',
            '{PASSWORD}': 'Password', '{URL}': 'URL', '{NOTES}': 'Notes'}
ELSEWHERE = {'{TOTP}', '{DB_DIR}'} | {
    '{URL:%s}' % part for part in (
        'RMVSCM', 'WITHOUTSCHEME', 'SCM', 'SCHEME', 'HOST', 'PORT', 'PATH',
        'QUERY', 'FRAGMENT', 'USERINFO', 'USERNAME', 'PASSWORD')} | {
    '{DT_%s%s}' % (utc, part) for utc in ('', 'UTC_') for part in (
        'SIMPLE', 'YEAR', 'MONTH', 'DAY', 'HOUR', 'MINUTE', 'SECOND')}
DEPTH = 10
# A value that refers to itself twice doubles at every level; past this size
# `show` computes it natively instead.
LONGEST = 1 << 16

class DbError(Exception):
    """The .kdbx file could not be read; the text says why, never a value."""


def default_db():
    """The .kdbx to read straight from, or None to use the Secret Service.

    $KEEPPASSXC_DB names it, and set to an empty string it means the Secret
    Service. Without it ~/Documents/<user>.kdbx is used when that file exists
    and keepassxc-cli is installed to read it.
    """
    if 'KEEPPASSXC_DB' in os.environ:
        return os.environ['KEEPPASSXC_DB'] or None
    if os.path.isfile(DEFAULT_DB) and shutil.which('keepassxc-cli'):
        return DEFAULT_DB
    return None


def cached_password(db):
    """The password from $XDG_RUNTIME_DIR/kpxc-auth: two lines, the real path
    of the database and then its password. None unless it names this db."""
    runtime = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    path = os.path.join(runtime, 'kpxc-auth')
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    if len(lines) >= 2 and lines[0] == os.path.realpath(db):
        return lines[1]
    return None


def read_password(db=None, ask=True):
    """Cached session password when present, else the TTY prompt or one line
    of stdin. With ask=False only the cache counts, and None means none."""
    if db is not None:
        cached = cached_password(db)
        if cached is not None:
            return cached
    if not ask:
        return None
    if sys.stdin.isatty():
        return getpass.getpass('KeePassXC database password: ')
    # Byte by byte: the rest of stdin may belong to the command kpxc-run
    # starts, and a buffered read would swallow it.
    line = b''
    try:
        while True:
            byte = os.read(0, 1)
            if not byte or byte == b'\n':
                break
            line += byte
    except OSError:
        pass
    return line.decode(errors='replace')


def keepassxc_cli(password, *cli_args):
    """(returncode, stdout bytes, stderr text). Every call decrypts the whole
    database again, and the key derivation takes seconds by design."""
    try:
        proc = subprocess.run(['keepassxc-cli', *cli_args],
                              input=(password + '\n').encode(),
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        raise DbError('keepassxc-cli is not installed') from None
    return (proc.returncode, proc.stdout,
            proc.stderr.decode(errors='replace').strip())


class Unresolved(Exception):
    """A placeholder left for `keepassxc-cli show` to resolve."""


def kind(text):
    """Entry::placeholderType: 'S', 'REF', a STANDARD key, 'ELSEWHERE', or
    None for text that KeePassXC leaves as it is."""
    if not (text.startswith('{') and text.endswith('}')):
        return None
    if text.startswith('{S:'):
        return 'S'
    if text.startswith('{REF:'):
        return 'REF'
    upper = text.upper()
    if upper in STANDARD:
        return upper
    return 'ELSEWHERE' if upper in ELSEWHERE else None


def resolve(value, fields, tree, depth=DEPTH):
    """value with its placeholders resolved the way `keepassxc-cli show` does:
    every placeholder found is replaced everywhere in the text, and a text
    that changed is scanned again. fields is the entry the value belongs to,
    tree every entry for references. Raises Unresolved for a placeholder
    resolved elsewhere."""
    if depth <= 0:
        return value
    result = value
    for token in PLACEHOLDER.findall(value):
        result = result.replace(token,
                                resolve_one(token, fields, tree, depth - 1))
        if len(result) > LONGEST:
            raise Unresolved(token)
    if result != value:
        result = resolve(result, fields, tree, depth - 1)
    return result


def resolve_one(token, fields, tree, depth):
    """Entry::resolvePlaceholderRecursive for one placeholder."""
    if depth <= 0:
        return token
    found = kind(token)
    if found is None:
        return token
    if found == 'ELSEWHERE':
        raise Unresolved(token)
    if found == 'S':
        return fields.get(token[3:-1], '')
    if found == 'REF':
        reference = REFERENCE.search(token)
        if not reference:
            return token
        wanted, search_in, term = reference.groups()
        wanted, search_in = wanted.upper(), search_in.upper()
        if search_in == 'I' and not re.match(r'^[0-9A-Fa-f]{32}$', term):
            raise Unresolved(token)
        for _path, uuid, other in tree:
            if search_in == 'I':
                hit = uuid == term.lower()
            elif search_in == 'O':
                hit = term in other.values()
            else:
                hit = other.get(FIELD[search_in], '') == term
            if hit:
                raw = uuid if wanted == 'I' else other.get(FIELD[wanted], '')
                return resolve(raw, other, tree, depth - 1)
        return ''
    field = fields.get(STANDARD[found], '')
    if kind(field) == found:
        return field
    return resolve(field, fields, tree, depth - 1)


def read_tree(db, password):
    """[(path, uuid hex, {field: raw value})] for every entry, in the order
    `keepassxc-cli ls -R` lists them, from one decryption of the database.

    `keepassxc-cli export` hands the whole tree over as XML on a pipe, so
    nothing reaches the disk. path is None for an entry that is no variable:
    one in the recycle bin, which the Secret Service does not offer either,
    and one keepassxc-cli cannot address - an empty title, or a '/' in a title
    or an empty or '/' in a group name. References still reach all of them.
    Control characters that XML 1.0 cannot carry are lost in the export.
    """
    code, out, err = keepassxc_cli(password, 'export', '-q', '-f', 'xml',
                                   '--', db)
    if code != 0:
        raise DbError('cannot read %s: %s' % (
            db, err or 'wrong password, or not a KeePassXC database'))
    # The writer leaves a carriage return raw, and an XML parser would turn
    # it into a newline; as a character reference it survives.
    out = out.replace(b'\r', b'&#13;')
    try:
        document = ElementTree.fromstring(out)
    except ElementTree.ParseError as error:
        raise DbError('unreadable export of %s: %s' % (db, error)) from None
    root = document.find('Root/Group')
    if root is None:
        raise DbError('no entries in the export of %s' % db)
    recycle_bin = None
    if document.findtext('Meta/RecycleBinEnabled', '') == 'True':
        recycle_bin = document.findtext('Meta/RecycleBinUUID', '')
    tree = []

    def walk(group, prefix):
        for child in group:
            if child.tag == 'Entry':
                fields = {string.findtext('Key', ''):
                          string.findtext('Value', '')
                          for string in child.findall('String')}
                title = fields.get('Title', '')
                addressable = (prefix is not None and title.strip()
                               and '/' not in title)
                uuid = base64.b64decode(child.findtext('UUID', '')).hex()
                tree.append((prefix + title if addressable else None,
                             uuid, fields))
            elif child.tag == 'Group':
                name = child.findtext('Name', '')
                skip = (prefix is None or not name or '/' in name
                        or child.findtext('UUID', '') == recycle_bin)
                walk(child, None if skip else prefix + name + '/')

    walk(root, '')
    return tree


def shown(db, password, path, keys):
    """{key: value} via `keepassxc-cli show` for one entry: one more
    decryption, spent only on a placeholder resolve() does not cover."""
    arguments = []
    for key in keys:
        arguments += ['-a', key]
    code, out, _err = keepassxc_cli(password, 'show', '-q', '-s', *arguments,
                                    '--', db, path)
    if code != 0:
        return None
    text = out.decode(errors='replace')
    text = text[:-1] if text.endswith('\n') else text
    if len(keys) == 1:
        return {keys[0]: text}
    lines = text.split('\n')
    if len(lines) == len(keys):
        return dict(zip(keys, lines))
    # One of the values spans lines, so they cannot be told apart.
    found = {}
    for key in keys:
        value = shown(db, password, path, [key])
        if value is None:
            return None
        found.update(value)
    return found


def db_entries(db, password, needs_value=lambda name, hot, attrs: True):
    """[(name, value, hot, attrs)] read straight from a .kdbx file.

    Uses keepassxc-cli only: no GUI and no D-Bus Secret Service involved, and
    the database is decrypted once however many entries it holds.
    A variable is an entry whose kpxc-env attribute names it; without the
    attribute the entry title is used when it looks like a shell variable.
    attrs carries the kpxc-env attributes; value is None where needs_value
    said the caller has no use for it. Raises DbError.
    """
    tree = read_tree(db, password)
    # keepassxc-cli addresses entries by path, and a path held by two entries
    # always means the first of them.
    first = {}
    for path, _uuid, fields in tree:
        if path is not None:
            first.setdefault(path, fields)
    rows = []
    for path, _uuid, _fields in tree:
        if path is None or path not in first:
            continue
        fields = first.pop(path)
        keys = [key for key in (ATTR, HOT, PROFILE) if key in fields]
        try:
            attrs = {key: resolve(fields[key], fields, tree) for key in keys}
        except Unresolved:
            attrs = shown(db, password, path, keys)
            if attrs is None:
                continue
        attrs = {key: value.strip() for key, value in attrs.items()}
        name = attrs.get(ATTR) or fields.get('Title', '').strip()
        if not VARIABLE.match(name):
            continue
        hot = bool(attrs.get(HOT))
        value = None
        if needs_value(name, hot, attrs):
            try:
                value = resolve(fields.get('Password', ''), fields, tree)
            except Unresolved:
                value = (shown(db, password, path, ['Password'])
                         or {}).get('Password')
                if value is None:
                    continue
        rows.append((name, value, hot, attrs))
    return rows


def collection():
    try:
        import secretstorage
    except ImportError:
        sys.exit('kpxc-run: the python secretstorage module is not installed')
    try:
        connection = secretstorage.dbus_init()
        for item in secretstorage.get_all_collections(connection):
            if item.collection_path.endswith('/session'):
                continue
            if not item.is_locked():
                return item
    except Exception as error:                         # noqa: BLE001
        sys.exit('kpxc-run: cannot reach the secret service: %s' % error)
    return None


def wanted(attrs, name, args):
    if args.all:
        return True
    if name in args.var:
        return True
    if args.profile:
        profiles = [p.strip() for p in attrs.get(PROFILE, '').split(',')]
        return args.profile in profiles
    return False


def main():
    parser = argparse.ArgumentParser(
        prog='kpxc-run', description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    parser.add_argument('--profile', help='inject variables tagged with this '
                                          'profile name')
    parser.add_argument('--var', action='append', default=[],
                        help='inject this variable, repeatable')
    parser.add_argument('--all', action='store_true',
                        help='inject every stored variable')
    parser.add_argument('--quiet', action='store_true',
                        help='do not warn when nothing could be injected')
    parser.add_argument('--db', default=None,
                        help='read variables straight from this .kdbx file via '
                             'keepassxc-cli (no GUI/Secret Service); defaults '
                             'to $KEEPPASSXC_DB, else %s when it exists, else '
                             'the Secret Service' % DEFAULT_DB)
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()

    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        parser.print_help()
        return 2
    if not (args.all or args.var or args.profile):
        sys.exit('kpxc-run: choose --profile, --var or --all')

    environment = dict(os.environ)
    injected = 0
    withheld = []
    db = args.db or default_db()
    coll = None
    if db:
        if not os.path.isfile(db):
            sys.exit('kpxc-run: database not found: %s' % db)
        try:
            rows = db_entries(
                db, read_password(db),
                lambda name, _hot, attrs: wanted(attrs, name, args))
        except DbError as error:
            sys.exit('kpxc-run: %s' % error)
        for name, value, _hot, attrs in rows:
            if not wanted(attrs, name, args):
                continue
            environment[name] = value
            injected += 1
    else:
        coll = collection()
    if coll is not None:
        from secretstorage.exceptions import LockedException
        for item in coll.get_all_items():
            try:
                attrs = item.get_attributes()
            except Exception:                          # noqa: BLE001
                continue
            name = attrs.get(ATTR)
            if not name or not VARIABLE.match(name) or not wanted(attrs, name, args):
                continue
            try:
                environment[name] = item.get_secret().decode('utf-8', 'replace')
                injected += 1
            except LockedException:
                withheld.append(name)
            except Exception:                          # noqa: BLE001
                continue

    if not args.quiet:
        if withheld:
            print('kpxc-run: %d variable(s) withheld (%s). %s'
                  % (len(withheld), ', '.join(withheld), CONFIRM_HINT),
                  file=sys.stderr)
        elif injected == 0:
            print('kpxc-run: nothing injected - no variable matched, or the '
                  'database is locked', file=sys.stderr)

    try:
        os.execvpe(command[0], command, environment)
    except FileNotFoundError:
        sys.exit('kpxc-run: command not found: %s' % command[0])
    except OSError as error:
        sys.exit('kpxc-run: cannot run %s: %s' % (command[0], error))


if __name__ == '__main__':
    sys.exit(main())
