#!/usr/bin/env python3
"""Run a command with secrets from KeePassXC in its environment, and nowhere else.

The variables never enter the ambient environment: they are read from the
unlocked database, placed in the child process's environment, and gone when it
exits. This is what the shims written by `kpxc-env shim` call.

  kpxc-run --profile terraform -- terraform apply
  kpxc-run --var GITHUB_TOKEN -- gh pr list
  kpxc-run --all -- env            # every stored variable, hot ones included

A profile is just a name listed in an entry's kpxc-env-profile attribute, so a
variable can serve several commands:

  kpxc-env list                    # see what is stored
"""

import argparse
import base64
import getpass
import os
import re
import subprocess
import sys
from xml.etree import ElementTree

PROG = 'kpxc-run'
ATTR = 'kpxc-env'
HOT = 'kpxc-env-hot'
PROFILE = 'kpxc-env-profile'
CONFIRM_HINT = ('KeePassXC asks every client for a confirmation dialog and '
                'this one was never answered. Untick "Confirm when passwords '
                'are retrieved by clients" in KeePassXC: Settings > Secret '
                'Service Integration.')

DEFAULT_DB = os.path.join(os.path.expanduser('~'), 'Documents',
                          '%s.kdbx' % getpass.getuser())
VARIABLE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
# KeePassXC placeholders this script resolves itself, exactly as `keepassxc-cli
# show` would. Anything else in braces goes to `show` for that one entry.
PLACEHOLDER = re.compile(r'\{[^}]+\}')
REFERENCE = re.compile(r'^\{REF:([TUPANI])@([TUPANI]):([^}]+)\}$')
FIELD = {'T': 'Title', 'U': 'UserName', 'P': 'Password', 'A': 'URL',
         'N': 'Notes'}
STANDARD = {'{TITLE}': 'Title', '{USERNAME}': 'UserName',
            '{PASSWORD}': 'Password', '{URL}': 'URL', '{NOTES}': 'Notes'}


def default_db():
    """The .kdbx to read straight from, or None to use the Secret Service.

    $KEEPPASSXC_DB names it; otherwise ~/Documents/<user>.kdbx when it exists.
    """
    return (os.environ.get('KEEPPASSXC_DB')
            or (DEFAULT_DB if os.path.isfile(DEFAULT_DB) else None))


def cached_password(db):
    runtime = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    path = os.path.join(runtime, 'kpxc-auth')
    try:
        with open(path) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    if len(lines) >= 2 and lines[0] == os.path.realpath(db):
        return lines[1]
    return None


def read_password(db=None):
    """Cached session password when present, else stdin/TTY prompt."""
    if db is not None:
        cached = cached_password(db)
        if cached is not None:
            return cached
    if sys.stdin.isatty():
        return getpass.getpass('KeePassXC database password: ')
    line = sys.stdin.readline()
    return line.rstrip('\n')


def keepassxc_cli(password, *cli_args):
    """(returncode, stdout bytes, stderr text). Every call decrypts the whole
    database again, and the key derivation takes seconds by design."""
    proc = subprocess.run(['keepassxc-cli', *cli_args],
                          input=(password + '\n').encode(),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return (proc.returncode, proc.stdout,
            proc.stderr.decode(errors='replace').strip())


class Unresolved(Exception):
    """A placeholder left for `keepassxc-cli show` to resolve."""


def resolve(value, fields, tree, depth=0):
    """value with its placeholders resolved the way `keepassxc-cli show` does.

    Raises Unresolved for anything not covered here: an unknown or
    lower-case placeholder, a missing reference target, a loop."""
    if not PLACEHOLDER.search(value):
        return value
    if depth > 8:
        raise Unresolved(value)

    def one(match):
        token = match.group(0)
        if token in STANDARD:
            return resolve(fields.get(STANDARD[token], ''), fields, tree,
                           depth + 1)
        if token.startswith('{S:') and token[3:-1] in fields:
            return resolve(fields[token[3:-1]], fields, tree, depth + 1)
        reference = REFERENCE.match(token)
        if not reference:
            raise Unresolved(token)
        wanted, search_in, term = reference.groups()
        for _path, uuid, other in tree:
            if search_in == 'I':
                if len(term) != 32 or uuid != term.lower():
                    continue
            elif other.get(FIELD[search_in], '') != term:
                continue
            if wanted == 'I':
                return uuid
            return resolve(other.get(FIELD[wanted], ''), other, tree,
                           depth + 1)
        raise Unresolved(token)

    return PLACEHOLDER.sub(one, value)


def read_tree(db, password):
    """[(path, uuid hex, {field: raw value})] for every entry, in the order
    `keepassxc-cli ls -R` lists them, from one decryption of the database.

    `keepassxc-cli export` hands the whole tree over as XML on a pipe, so
    nothing reaches the disk. path is None for an entry that keepassxc-cli
    cannot address: an empty title, or a '/' inside a title or group name.
    """
    code, out, err = keepassxc_cli(password, 'export', '-q', '-f', 'xml', db)
    if code != 0:
        sys.exit('%s: cannot read %s: %s' % (PROG, db, err))
    try:
        root = ElementTree.fromstring(out).find('Root/Group')
    except ElementTree.ParseError as error:
        sys.exit('%s: unreadable export of %s: %s' % (PROG, db, error))
    if root is None:
        sys.exit('%s: no entries in the export of %s' % (PROG, db))
    tree = []

    def walk(group, prefix):
        for child in group:
            if child.tag == 'Entry':
                fields = {string.findtext('Key', ''):
                          string.findtext('Value', '')
                          for string in child.findall('String')}
                title = fields.get('Title', '')
                addressable = (prefix is not None and title.strip()
                               and '/' not in title)
                uuid = base64.b64decode(child.findtext('UUID', '')).hex()
                tree.append((prefix + title if addressable else None,
                             uuid, fields))
            elif child.tag == 'Group':
                name = child.findtext('Name', '')
                walk(child, None if prefix is None or '/' in name
                     else prefix + name + '/')

    walk(root, '')
    return tree


def shown(db, password, path, keys):
    """{key: value} via `keepassxc-cli show` for one entry: one more
    decryption, spent only on a placeholder resolve() does not cover."""
    arguments = []
    for key in keys:
        arguments += ['-a', key]
    code, out, _err = keepassxc_cli(password, 'show', '-q', '-s', *arguments,
                                    db, path)
    if code != 0:
        return None
    text = out.decode(errors='replace')
    if keys == ['Password']:
        return {'Password': text[:-1] if text.endswith('\n') else text}
    return dict(zip(keys, text.split('\n')))


def db_entries(db, password, needs_value=lambda name, hot, attrs: True):
    """[(name, value, hot, attrs)] read straight from a .kdbx file.

    Uses keepassxc-cli only: no GUI and no D-Bus Secret Service involved, and
    the database is decrypted once however many entries it holds.
    A variable is an entry whose kpxc-env attribute names it; without the
    attribute the entry title is used when it looks like a shell variable.
    attrs carries the kpxc-env attributes; value is None where needs_value
    said the caller has no use for it.
    """
    tree = read_tree(db, password)
    # keepassxc-cli addresses entries by path, and a path held by two entries
    # always means the first of them.
    first = {}
    for path, _uuid, fields in tree:
        if path is not None:
            first.setdefault(path, fields)
    rows = []
    for path, _uuid, _fields in tree:
        if path is None:
            continue
        fields = first[path]
        keys = [key for key in (ATTR, HOT, PROFILE) if key in fields]
        try:
            attrs = {key: resolve(fields[key], fields, tree) for key in keys}
        except Unresolved:
            attrs = shown(db, password, path, keys)
            if attrs is None:
                continue
        attrs = {key: value.strip() for key, value in attrs.items()}
        name = attrs.get(ATTR) or fields.get('Title', '').strip()
        if not VARIABLE.match(name):
            continue
        hot = bool(attrs.get(HOT))
        value = None
        if needs_value(name, hot, attrs):
            try:
                value = resolve(fields.get('Password', ''), fields, tree)
            except Unresolved:
                value = (shown(db, password, path, ['Password'])
                         or {}).get('Password')
                if value is None:
                    continue
        rows.append((name, value, hot, attrs))
    return rows


def collection():
    try:
        import secretstorage
    except ImportError:
        sys.exit('kpxc-run: the python secretstorage module is not installed')
    try:
        connection = secretstorage.dbus_init()
        for item in secretstorage.get_all_collections(connection):
            if item.collection_path.endswith('/session'):
                continue
            if not item.is_locked():
                return item
    except Exception as error:                         # noqa: BLE001
        sys.exit('kpxc-run: cannot reach the secret service: %s' % error)
    return None


def wanted(attrs, name, args):
    if args.all:
        return True
    if name in args.var:
        return True
    if args.profile:
        profiles = [p.strip() for p in attrs.get(PROFILE, '').split(',')]
        return args.profile in profiles
    return False


def main():
    parser = argparse.ArgumentParser(
        prog='kpxc-run', description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    parser.add_argument('--profile', help='inject variables tagged with this '
                                          'profile name')
    parser.add_argument('--var', action='append', default=[],
                        help='inject this variable, repeatable')
    parser.add_argument('--all', action='store_true',
                        help='inject every stored variable')
    parser.add_argument('--quiet', action='store_true',
                        help='do not warn when nothing could be injected')
    parser.add_argument('--db', default=None,
                        help='read variables straight from this .kdbx file via '
                             'keepassxc-cli (no GUI/Secret Service); defaults '
                             'to $KEEPPASSXC_DB, else %s when it exists, else '
                             'the Secret Service' % DEFAULT_DB)
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()

    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        parser.print_help()
        return 2
    if not (args.all or args.var or args.profile):
        sys.exit('kpxc-run: choose --profile, --var or --all')

    environment = dict(os.environ)
    injected = 0
    withheld = []
    db = args.db or default_db()
    coll = None
    if db:
        if not os.path.isfile(db):
            sys.exit('kpxc-run: database not found: %s' % db)
        password = read_password(db)
        for name, value, _hot, attrs in db_entries(
                db, password,
                lambda name, _hot, attrs: wanted(attrs, name, args)):
            if not wanted(attrs, name, args):
                continue
            environment[name] = value
            injected += 1
    else:
        coll = collection()
    if coll is not None:
        from secretstorage.exceptions import LockedException
        for item in coll.get_all_items():
            try:
                attrs = item.get_attributes()
            except Exception:                          # noqa: BLE001
                continue
            name = attrs.get(ATTR)
            if not name or not wanted(attrs, name, args):
                continue
            try:
                environment[name] = item.get_secret().decode('utf-8', 'replace')
                injected += 1
            except LockedException:
                withheld.append(name)
            except Exception:                          # noqa: BLE001
                continue

    if not args.quiet:
        if withheld:
            print('kpxc-run: %d variable(s) withheld (%s). %s'
                  % (len(withheld), ', '.join(withheld), CONFIRM_HINT),
                  file=sys.stderr)
        elif injected == 0:
            print('kpxc-run: nothing injected - is the database unlocked?',
                  file=sys.stderr)

    try:
        os.execvpe(command[0], command, environment)
    except FileNotFoundError:
        sys.exit('kpxc-run: command not found: %s' % command[0])
    except OSError as error:
        sys.exit('kpxc-run: cannot run %s: %s' % (command[0], error))


if __name__ == '__main__':
    sys.exit(main())
