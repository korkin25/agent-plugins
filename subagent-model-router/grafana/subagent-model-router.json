        "h": 5
      },
      "description": "Last received worker snapshot. Workers exit after five minutes per run; later calls restart them. Last-success reports the previous acknowledgement (one flush lag); an old snapshot alone does not establish failure. Instance scoped; agent/project/user selection does not apply.",
      "targets": [
        {
          "expr": "sum(last_over_time(smr_telemetry_pending_events{instance=~\"$instance\"}[$__range]))",
