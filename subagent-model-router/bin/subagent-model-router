"""subagent-model-router: модель субагенту Claude Code и Codex выбирает Jev (TypeSafe AI).

Хук PreToolUse и команды check/explain/stats/codex-trust; только stdlib, Python ≥ 3.11.
"""
from __future__ import annotations

